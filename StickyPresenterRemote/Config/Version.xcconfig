// Version.xcconfig — 리모컨 앱(StickyPresenterRemote)
//
// **버전과 빌드 번호의 단일 소스.** DeployBar 가 배포할 때 이 파일을 고친다 (→ deploy.env 의 VERSION_XCCONFIG).
// project.yml 의 프로젝트 레벨 configFiles 로 연결돼 있다. 예전엔 project.yml 의 settings.base 에
// 숫자를 적었는데, 그러면 DeployBar 가 project.pbxproj 만 고치고 다음 `xcodegen generate` 가 되돌린다.
//
// ⚠️ project.yml 의 settings.base 에 같은 키를 다시 넣지 말 것 — 타겟 설정이 xcconfig 를 이겨 이 파일이 무시된다.
//
// 마케팅 버전은 Mac 앱과 맞춘다 — 둘이 한 릴리즈로 함께 움직이고,
// 리모컨 기능은 양쪽이 같은 버전이어야 맞물린다 (위치 옮기기·페어링 코드가 그 예).
//
// 빌드 번호는 이 앱 안에서만 올리면 된다. iOS 는 마케팅 버전이 올라가면 빌드 번호를 1 로 되돌릴 수 있다
// (같은 마케팅 버전 안에서만 유일하면 된다). 1.0 이 2, 1.0.7 이 3 이었고, 1.0.8 은 1 로 되돌렸다.
// ⚠️ Mac 앱은 규칙이 다르다 — 앱 전체에서 단조 증가해야 한다. 두 앱의 빌드 번호를 같이 맞추려 들지 말 것.
// 만약 이 앱도 이전 빌드 번호를 사유로 거절되면 그보다 크게 올릴 것.

// 사람이 읽는 버전 (App Store 에 보이는 번호)
MARKETING_VERSION = 1.0.8

// 빌드 번호 — 업로드마다 올린다
CURRENT_PROJECT_VERSION = 1
