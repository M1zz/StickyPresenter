// Version.xcconfig
//
// **버전과 빌드 번호의 단일 소스.** DeployBar 가 배포할 때 이 파일을 고친다 (→ deploy.env 의 VERSION_XCCONFIG).
// project.yml 의 프로젝트 레벨 configFiles 로 연결돼 있어 앱·위젯 두 타겟이 같은 값을 쓴다.
//
// 예전에는 앱 버전이 StickyPresenter/Info.plist 에 글자로 박혀 있고, 위젯만 project.yml 에서
// MARKETING_VERSION 을 가졌다. 그래서 앱 타겟의 빌드 설정에는 버전이 없었고 DeployBar 는
// 로컬 버전을 `?` 로 읽었다. 거기서 패치 +0.0.1 을 누르면 `?` → 0.0.1 이 되어 위젯 버전만
// 0.0.1 로 덮였다 — 앱 1.0.9 에 위젯 0.0.1 을 넣은 번들은 App Store 검증에서 거절된다.
// 이제 두 Info.plist 모두 $(MARKETING_VERSION)·$(CURRENT_PROJECT_VERSION) 을 읽는다.
//
// ⚠️ **project.yml 의 settings.base 에 같은 키를 다시 넣지 말 것.** 타겟 빌드 설정은
//    xcconfig 보다 우선해서, 넣는 순간 이 파일이 조용히 무시된다.
//    Info.plist 에 버전 숫자를 직접 적는 것도 같은 이유로 금지.
//
// ⚠️ CURRENT_PROJECT_VERSION 은 **앱 하나 전체에서 하나뿐인 눈금이다. 올리기만 한다.**
//    마케팅 버전을 올렸다고 1부터 다시 세지 못한다 — 스토어는 마케팅 버전과 상관없이
//    '이 앱에 올라온 가장 큰 빌드 번호'만 본다.
//      "must contain a higher version than that of the previously uploaded version"
//    6(1.0.4), 7(1.0.5), 8(1.0.6), 9(1.0.7), 10(1.0.8) 다음이므로 1.0.9 는 11. 다음 업로드는 12 이상.
//    (1.0.8 도 1 로 되돌렸다가 [9] 를 사유로 거절당했다.)
//
// 리모컨 앱(StickyPresenterRemote)은 따로 올리는 별개 앱이라 여기와 무관하다.

// 사람이 읽는 버전 (App Store 에 보이는 번호)
MARKETING_VERSION = 1.0.9

// 빌드 번호 — 업로드마다 올린다
CURRENT_PROJECT_VERSION = 11
