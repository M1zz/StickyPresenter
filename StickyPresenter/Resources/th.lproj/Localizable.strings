"guide.timers.4" = "“หน้าต่าง” เปิดตัวจับเวลาเป็นหน้าต่างปกติ คุณจึงแชร์เฉพาะหน้าต่างนั้นผ่านการแชร์หน้าจอหรือ AirPlay ได้";
"guide.timers.5" = "ปุ่มธีมสลับระหว่างสว่าง มืด และกิ้งก่า ซึ่งปรับสีตามหน้าจอที่อยู่ด้านหลัง กิ้งก่าต้องได้รับสิทธิ์การบันทึกหน้าจอ";
"guide.timers.6" = "แถบเพลงเล่นเพลงประกอบขณะที่คุณเตรียมตัว คุณต้องเพิ่มเพลงลงในโฟลเดอร์เอง";
"guide.pomodoro.title" = "โพโมโดโร";
"guide.pomodoro.summary" = "สลับช่วงโฟกัสและช่วงพักไปเรื่อยๆ จนกว่าคุณจะหยุด";
"guide.pomodoro.1" = "พิมพ์เวลาโฟกัสและเวลาพักคั่นด้วยเครื่องหมายทับ เช่น 25/5 หรือ 50m/10m เพื่อเริ่มโพโมโดโร";
"guide.pomodoro.2" = "ทุกครั้งที่สลับจะมีเสียงเตือนต่างกัน และวิดเจ็ตจะเป็นสีแดงช่วงโฟกัส สีเขียวช่วงพัก";
"guide.pomodoro.3" = "กด ⌘⌃B ที่ไหนก็ได้เพื่อเริ่มโฟกัส 25 นาที พัก 5 นาที";
"guide.teleprompter.title" = "เทเลพรอมป์เตอร์";
"guide.teleprompter.summary" = "สคริปต์เลื่อนด้วยจังหวะสม่ำเสมอ คุณจึงอ่านไปพร้อมมองกล้องได้";
"guide.teleprompter.1" = "คัดลอกสคริปต์แล้วกด ⌘⌃P เพื่อเปิดในเทเลพรอมป์เตอร์ ใช้ไอคอนดินสอเพื่อแก้ไขที่นั่น";
"guide.teleprompter.2" = "กดเล่นเพื่อเริ่มเลื่อน และจะหยุดเองเมื่อถึงท้ายสคริปต์";
"guide.teleprompter.3" = "“กลับด้าน” พลิกข้อความสำหรับอุปกรณ์เทเลพรอมป์เตอร์ที่ใช้กระจกสะท้อน";
"guide.teleprompter.4" = "ความเร็ว ขนาดตัวอักษร และการกลับด้านจะถูกจำไว้ใช้ครั้งหน้า";
"guide.remote.title" = "รีโมต iPhone";
"guide.remote.summary" = "เริ่มและหยุดตัวจับเวลาจาก iPhone ขณะอยู่บนเวที";
"guide.remote.1" = "ดาวน์โหลด Remote Controller for Sticky จาก App Store บน iPhone";
"guide.remote.2" = "เลือก Mac เครื่องนี้ในแอป แล้วป้อนรหัสสี่หลักจากแถบเมนู ▸ รีโมต";
"guide.remote.3" = "iPhone และ Mac ต้องอยู่ใน Wi‑Fi เดียวกัน หลังจากครั้งแรกจะเชื่อมต่อได้โดยไม่ต้องใช้รหัส";
"guide.remote.4" = "รีโมตหลายเครื่องควบคุม Mac เครื่องเดียวได้ ผู้พูดและผู้ดูแลเวทีจึงใช้ได้ทั้งคู่";
"guide.shortcuts.title" = "ปุ่มลัด";
"guide.shortcuts.summary" = "ใช้ได้ทุกที่ แม้จะมีแอปอื่นอยู่ด้านหน้าหรือกำลังนำเสนออยู่";
"guide.shortcuts.taken" = "ถูกใช้โดยแอปอื่น";
"guide.shortcuts.note" = "กด Command (⌘) และ Control (⌃) พร้อมกัน ปุ่มลัดที่ระบุว่า “ถูกใช้โดยแอปอื่น” จะกลับมาใช้ได้เมื่อแอปนั้นปิดลง";
"guide.support" = "หน้าสนับสนุน";
"guide.next" = "ถัดไป";
"guide.done" = "เริ่มใช้งาน";

