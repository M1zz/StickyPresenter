"guide.timers.title" = "Bộ hẹn giờ";
"guide.timers.summary" = "Theo dõi thời gian bằng một widget nhỏ ở góc màn hình.";
"guide.timers.1" = "Nhập thời gian trong cửa sổ Bộ hẹn giờ rồi nhấn Return. Dấu hỏi cạnh ô nhập liệt kê các định dạng.";
"guide.timers.2" = "Khi chưa có bộ hẹn giờ, chỉ cần nhấp một nút Bắt đầu nhanh là chạy. Dùng biểu tượng bút chì để đổi các mốc đó.";
"guide.timers.3" = "Hiện/Ẩn và Căn chỉnh sẽ ẩn một widget hoặc xếp các widget cạnh cửa sổ Bộ hẹn giờ.";
"guide.timers.4" = "Cửa sổ mở bộ hẹn giờ thành một cửa sổ thông thường, nên bạn có thể chỉ chia sẻ cửa sổ đó qua chia sẻ màn hình hoặc AirPlay.";
"guide.timers.5" = "Nút chủ đề chuyển qua lại giữa sáng, tối và Tắc kè hoa, chủ đề tự phối màu theo màn hình phía sau. Tắc kè hoa cần quyền Ghi màn hình.";
"guide.timers.6" = "Thanh nhạc phát nhạc nền khi bạn chuẩn bị. Bạn tự thêm bài hát vào một thư mục.";
"guide.pomodoro.title" = "Pomodoro";
