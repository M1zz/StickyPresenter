"guide.welcome.title" = "Getting Started";
"guide.welcome.summary" = "StickyPresenter gives you notes, timers, and a teleprompter that float above Keynote, even in full screen.";
"guide.welcome.1" = "Every window floats above full-screen slides without stealing focus from your presentation app.";
"guide.welcome.2" = "Everything lives in the note icon in the menu bar. There is no Dock icon.";
"guide.welcome.3" = "Notes are saved on this Mac as you type and come back in the same place next time.";
"guide.welcome.4" = "Open this guide again any time from the menu bar ▸ Help ▸ User Guide.";
"guide.notes.title" = "Sticky Notes";
"guide.notes.summary" = "Pin your script or reminders on top of your slides.";
"guide.notes.1" = "Drag anywhere on a note to move it. Drag an edge to resize it.";
"guide.notes.2" = "Hover over a note to show its buttons for color, opacity, and text size.";
"guide.notes.3" = "Lock a note so nothing changes by accident while you present.";
"guide.notes.4" = "Closed a note by mistake? Reopen Closed Note in the menu brings back your last 20.";
"guide.notes.5" = "Copy your script and press ⌘⌃V to turn it into a new note.";
"guide.timers.title" = "Timers";
"guide.timers.summary" = "Keep an eye on your time with a small widget in the corner.";
"guide.timers.1" = "Type a time in the Timers window and press Return. The question mark next to the field lists the formats.";
"guide.timers.2" = "With no timers, one click on a Quick Start button starts one. Use the pencil to change those times.";
"guide.timers.3" = "Show/Hide and Align hide a widget or line widgets up next to the Timers window.";
"guide.timers.4" = "Window opens the timer as a regular window, so you can share just that window over screen sharing or AirPlay.";
"guide.timers.5" = "The theme button cycles through light, dark, and Chameleon, which matches the screen behind it. Chameleon needs Screen Recording permission.";
"guide.timers.6" = "The music bar plays background music while you prepare. You add the tracks to a folder yourself.";
"guide.pomodoro.title" = "Pomodoro";
"guide.pomodoro.summary" = "Alternate focus and break sessions until you stop.";
"guide.pomodoro.1" = "Type focus and break times with a slash, like 25/5 or 50m/10m, to start a Pomodoro.";
"guide.pomodoro.2" = "A different chime plays at each switch, and the widget turns red for focus and green for breaks.";
"guide.pomodoro.3" = "Press ⌘⌃B anywhere to start a 25-minute focus with 5-minute breaks.";
"guide.teleprompter.title" = "Teleprompter";
"guide.teleprompter.summary" = "Your script scrolls at a steady pace so you can read while facing the camera.";
"guide.teleprompter.1" = "Copy your script and press ⌘⌃P to open it in the teleprompter. Use the pencil to edit it there.";
"guide.teleprompter.2" = "Press Play to start scrolling. It stops by itself at the end of the script.";
"guide.teleprompter.3" = "Mirror flips the text for teleprompter rigs with reflective glass.";
"guide.teleprompter.4" = "Speed, text size, and mirroring are remembered for next time.";
"guide.remote.title" = "iPhone Remote";
"guide.remote.summary" = "Start and stop timers from your iPhone on stage.";
"guide.remote.1" = "Get Remote Controller for Sticky from the App Store on your iPhone.";
"guide.remote.2" = "Pick this Mac in the app, then enter the four-digit code from the menu bar ▸ Remote.";
"guide.remote.3" = "Your iPhone and Mac need to be on the same Wi‑Fi. After the first time, they connect without a code.";
"guide.remote.4" = "Several remotes can control one Mac, so a presenter and a stage manager can both use it.";
"guide.shortcuts.title" = "Shortcuts";
"guide.shortcuts.summary" = "These work everywhere, even while another app is in front or you’re presenting.";
"guide.shortcuts.taken" = "Used by another app";
"guide.shortcuts.note" = "Hold Command (⌘) and Control (⌃) together. A shortcut marked “Used by another app” works again once that app quits.";
