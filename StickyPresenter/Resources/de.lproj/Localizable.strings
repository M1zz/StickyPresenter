"guide.welcome.title" = "Erste Schritte";
"guide.welcome.summary" = "StickyPresenter bietet dir Notizen, Timer und einen Teleprompter, die über Keynote schweben – auch im Vollbild.";
"guide.welcome.1" = "Jedes Fenster schwebt über Vollbild-Folien, ohne deiner Präsentations-App den Fokus zu nehmen.";
"guide.welcome.2" = "Alles steckt im Notizsymbol in der Menüleiste. Es gibt kein Dock-Symbol.";
"guide.welcome.3" = "Notizen werden beim Tippen auf diesem Mac gespeichert und erscheinen beim nächsten Mal an derselben Stelle.";
"guide.welcome.4" = "Dieses Handbuch öffnest du jederzeit wieder über Menüleiste ▸ Hilfe ▸ Benutzerhandbuch.";
"guide.notes.title" = "Haftnotizen";
"guide.notes.summary" = "Hefte dein Skript oder deine Erinnerungen über deine Folien.";
"guide.notes.1" = "Ziehe an einer beliebigen Stelle der Notiz, um sie zu verschieben. Ziehe am Rand, um die Größe zu ändern.";
"guide.notes.2" = "Fahre mit dem Zeiger über eine Notiz, um die Tasten für Farbe, Deckkraft und Schriftgröße einzublenden.";
"guide.notes.3" = "Sperre eine Notiz, damit während der Präsentation nichts versehentlich geändert wird.";
"guide.notes.4" = "Eine Notiz versehentlich geschlossen? „Geschlossene Notiz wieder öffnen“ im Menü holt die letzten 20 zurück.";
"guide.notes.5" = "Kopiere dein Skript und drücke ⌘⌃V, um daraus eine neue Notiz zu machen.";
"guide.timers.title" = "Timer";
"guide.timers.summary" = "Behalte deine Zeit mit einem kleinen Widget in der Ecke im Blick.";
"guide.timers.1" = "Gib im Timer-Fenster eine Zeit ein und drücke die Eingabetaste. Das Fragezeichen neben dem Feld zeigt die möglichen Formate.";
"guide.timers.2" = "Ohne Timer startet ein Klick auf eine Schnellstart-Taste sofort einen. Mit dem Stift änderst du diese Zeiten.";
"guide.timers.3" = "Mit „Einblenden/Ausblenden“ und „Anordnen“ blendest du ein Widget aus oder reihst Widgets neben dem Timer-Fenster auf.";
"guide.timers.4" = "„Fenster“ öffnet den Timer als normales Fenster, damit du bei Bildschirmfreigabe oder AirPlay nur dieses Fenster teilen kannst.";
"guide.timers.5" = "Mit der Design-Taste wechselst du zwischen Hell, Dunkel und Chamäleon, das sich dem Bildschirm dahinter anpasst. Chamäleon benötigt die Berechtigung „Bildschirmaufnahme“.";
"guide.timers.6" = "Die Musikleiste spielt Hintergrundmusik, während du dich vorbereitest. Die Titel legst du selbst in einem Ordner ab.";
"guide.pomodoro.title" = "Pomodoro";
"guide.pomodoro.summary" = "Fokus- und Pausenphasen wechseln sich ab, bis du stoppst.";
"guide.pomodoro.1" = "Gib Fokus- und Pausenzeit mit einem Schrägstrich ein, etwa 25/5 oder 50m/10m, um ein Pomodoro zu starten.";
"guide.pomodoro.2" = "Bei jedem Wechsel ertönt ein anderer Klang, und das Widget wird für den Fokus rot und für Pausen grün.";
"guide.pomodoro.3" = "Drücke überall ⌘⌃B, um 25 Minuten Fokus mit 5 Minuten Pause zu starten.";
"guide.teleprompter.title" = "Teleprompter";
"guide.teleprompter.summary" = "Dein Skript läuft in gleichmäßigem Tempo, damit du lesen und dabei in die Kamera schauen kannst.";
"guide.teleprompter.1" = "Kopiere dein Skript und drücke ⌘⌃P, um es im Teleprompter zu öffnen. Mit dem Stift bearbeitest du es dort.";
"guide.teleprompter.2" = "Mit „Wiedergabe“ startet das Scrollen. Am Ende des Skripts hält es von selbst an.";
"guide.teleprompter.3" = "„Spiegeln“ kehrt den Text um, für Teleprompter mit Spiegelglas.";
"guide.teleprompter.4" = "Tempo, Schriftgröße und Spiegelung bleiben für das nächste Mal gespeichert.";
"guide.remote.title" = "iPhone-Fernbedienung";
"guide.remote.summary" = "Starte und stoppe Timer auf der Bühne mit deinem iPhone.";
"guide.remote.1" = "Lade „Remote Controller for Sticky“ aus dem App Store auf dein iPhone.";
"guide.remote.2" = "Wähle in der App diesen Mac aus und gib den vierstelligen Code aus Menüleiste ▸ Fernbedienung ein.";
"guide.remote.3" = "iPhone und Mac müssen im selben WLAN sein. Nach dem ersten Mal verbinden sie sich ohne Code.";
"guide.remote.4" = "Mehrere Fernbedienungen können einen Mac steuern, sodass Vortragende und Bühnentechnik beide mitmachen können.";
"guide.shortcuts.title" = "Tastenkurzbefehle";
"guide.shortcuts.summary" = "Sie funktionieren überall, auch wenn eine andere App im Vordergrund ist oder du präsentierst.";
"guide.shortcuts.taken" = "Von anderer App belegt";
"guide.shortcuts.note" = "Halte Befehl (⌘) und Control (⌃) gleichzeitig gedrückt. Ein als „Von anderer App belegt“ markierter Kurzbefehl funktioniert wieder, sobald diese App beendet ist.";
"guide.support" = "Support-Seite";
